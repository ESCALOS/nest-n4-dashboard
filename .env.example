PORT=3000

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=n4_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL - Prisma (for user authentication)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/n4_dashboard

# SQL Server - N4 Terminal Database
N4_DB_HOST=n4-server-host
N4_DB_PORT=1433
N4_DB_USER=n4_user
N4_DB_PASSWORD=n4_password
N4_DB_NAME=n4_database

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Reporte TPR
TPR_CURRENT_MONTH_TTL_SECONDS=600
TPR_CLOSED_MONTH_TTL_SECONDS=604800
TPR_REGENERATION_LOCK_TTL_SECONDS=120
TPR_DETAIL_MAX_LIMIT=200
TPR_TIMEZONE=America/Lima
TPR_TRUCK_GATE_GKEY=53

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=3600
